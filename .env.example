# Supabase cloud project public browser configuration.
# Copy this file to .env.local and replace the placeholders from the project API settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-cloud-publishable-key

# Server-only. Never expose this value through a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=replace-with-cloud-secret-key

# Public HTTPS app URL used for Auth email redirects. Required for phone testing.
EVENTSPACE_APP_ORIGIN=https://app.example.com
